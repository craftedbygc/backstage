{
  "name": "@unseenco/theatre-core",
  "version": "0.4.3",
  "license": "Apache-2.0",
  "description": "Motion design editor for the web",
  "repository": {
    "type": "git",
    "url": "https://github.com/craftedbygc/theatre",
    "directory": "theatre/core"
  },
  "author": {
    "name": "TheaterJS Oy",
    "email": "hello@theatrejs.com",
    "url": "https://unseen-theatre.netlify.app"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./privateAPIs": {
      "types": "./dist/privateAPIs.d.ts",
      "import": "./dist/privateAPIs.mjs",
      "require": "./dist/privateAPIs.js"
    },
    "./lenis": {
      "types": "./dist/lenis.d.ts",
      "import": "./dist/lenis.mjs",
      "require": "./dist/lenis.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "prepublish": "node ../../devEnv/ensurePublishing.js"
  },
  "sideEffects": true,
  "dependencies": {
    "@unseenco/theatre-dataverse": "workspace:*"
  },
  "peerDependencies": {
    "lenis": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "lenis": {
      "optional": true
    }
  },
  "//": "Add packages here to make them externals of core. Add them to theatre/package.json if you want to bundle them with studio."
}

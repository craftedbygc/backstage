{
  "compileOnSave": false,
  "compilerOptions": {
    "moduleResolution": "node",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "target": "ESNext",
    "lib": ["es2017", "dom", "ESNext"],
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react",
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "declarationMap": true,
    "stripInternal": true,
    "declaration": true,
    "paths": {
      "@unseenco/theatre-core": ["./theatre/core/src/index.ts"],
      "@unseenco/theatre-core-lite": ["./theatre/core/src/index-lite.ts"],
      "@unseenco/theatre-core-lite/*": ["./theatre/core/src/*"],
      "@unseenco/theatre-studio": ["./theatre/studio/src/index.ts"],
      "@unseenco/theatre-studio-lite": ["./theatre/studio/src/index-lite.ts"],
      "@unseenco/theatre-studio-lite/*": ["./theatre/studio/src/*"],
      "@unseenco/theatre-studio/*": ["./theatre/studio/src/*"],
      "@unseenco/theatre-core/*": ["./theatre/core/src/*"],
      "@unseenco/theatre-core/lenis": ["./theatre/core/src/lenis.ts"],
      "@unseenco/theatre-shared/*": ["./theatre/shared/src/*"],
      "@unseenco/theatre-dataverse": ["./packages/dataverse/src/index.ts"],
      "@unseenco/theatre-react": ["./packages/react/src/index.ts"],
      "@unseenco/theatre-threejs": ["./packages/threejs/src/index.ts"],
      "@unseenco/theatre-threejs/extension": [
        "./packages/threejs/src/extension.ts"
      ],
      "@unseenco/theatre-gsap": ["./packages/gsap/src/index.ts"]
    },
    "forceConsistentCasingInFileNames": true
  },
  "exclude": ["**/node_modules", "**/.*", "**/xeno", "**/dist", "**/.temp"]
}

{
  "compileOnSave": false,
  "compilerOptions": {
    "moduleResolution": "node",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "target": "ESNext",
    "lib": [
      "es2017",
      "dom",
      "ESNext"
    ],
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react",
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "declarationMap": true,
    "stripInternal": true,
    "declaration": true,
    "paths": {
      "@unseenco/backstage": [
        "./backstage/core/src/index.ts"
      ],
      "@unseenco/backstage/privateAPIs": [
        "./backstage/core/src/privateAPIs.ts"
      ],
      "@unseenco/backstage/lenis": [
        "./backstage/core/src/lenis.ts"
      ],
      "@unseenco/backstage/core-lite": [
        "./backstage/core/src/index-lite.ts"
      ],
      "@unseenco/backstage/core-lite/*": [
        "./backstage/core/src/*"
      ],
      "@unseenco/backstage/studio": [
        "./backstage/studio/src/index.ts"
      ],
      "@unseenco/backstage/studio-lite": [
        "./backstage/studio/src/index-lite.ts"
      ],
      "@unseenco/backstage/studio-lite/*": [
        "./backstage/studio/src/*"
      ],
      "@unseenco/backstage/studio/*": [
        "./backstage/studio/src/*"
      ],
      "@unseenco/backstage/dataverse": [
        "./packages/dataverse/src/index.ts"
      ],
      "@unseenco/backstage/dataverse/*": [
        "./packages/dataverse/*"
      ],
      "@unseenco/backstage/react": [
        "./packages/react/src/index.ts"
      ],
      "@unseenco/backstage/threejs": [
        "./packages/threejs/src/index.ts"
      ],
      "@unseenco/backstage/threejs/extension": [
        "./packages/threejs/src/extension.ts"
      ],
      "@unseenco/backstage/gsap": [
        "./packages/gsap/src/index.ts"
      ],
      "@unseenco/backstage/*": [
        "./backstage/core/src/*"
      ],
      "@unseenco/backstage-shared/*": [
        "./backstage/shared/src/*"
      ]
    },
    "forceConsistentCasingInFileNames": true
  },
  "exclude": [
    "**/node_modules",
    "**/.*",
    "**/xeno",
    "**/dist",
    "**/.temp"
  ]
}

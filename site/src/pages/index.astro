---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Backstage.js">
  <section
    class="flex flex-col items-center justify-center py-12"
  >
    <div
      class="grid w-full max-w-4xl gap-6 sm:grid-cols-2 sm:gap-8"
    >
      <a href="/docs/" class="landing-card landing-card--docs group">
        <h2 class="text-2xl font-medium tracking-tight text-white">
          API docs
        </h2>
        <p class="mt-3 flex-1 text-sm leading-relaxed text-[#9aa0a6]">
          Explore guides, concepts, and the full API reference for building with
          Backstage.js.
        </p>
        <span
          class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-sky-300 transition group-hover:text-sky-200"
        >
          Get Started
          <svg
            class="size-3.5 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 18l6-6-6-6"></path>
          </svg>
        </span>
      </a>

      <a href="/playground/" class="landing-card landing-card--playground group">
        <h2 class="text-2xl font-medium tracking-tight text-white">
          Playground
        </h2>
        <p class="mt-3 flex-1 text-sm leading-relaxed text-[#9aa0a6]">
          Try the visual editor and live demos — see how timelines and Studio
          feel in the browser.
        </p>
        <span
          class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-amber-300 transition group-hover:text-amber-200"
        >
          See Backstage.js In Action
          <svg
            class="size-3.5 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 18l6-6-6-6"></path>
          </svg>
        </span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .landing-card {
    position: relative;
    display: flex;
    min-height: 220px;
    flex-direction: column;
    border-radius: 0.2rem;
    padding: 2.25rem 2rem;
    background-color: #141820;
    transition: background-color 0.25s ease;
  }

  .landing-card:hover {
    background-color: #171c26;
  }

  .landing-card > * {
    position: relative;
    z-index: 1;
  }

  .landing-card::before,
  .landing-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    padding: 1px;
    pointer-events: none;
    transition: opacity 0.25s ease;
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
  }

  .landing-card::before {
    opacity: 1;
  }

  .landing-card::after {
    opacity: 0;
  }

  .landing-card:hover::before {
    opacity: 0;
  }

  .landing-card:hover::after {
    opacity: 1;
  }

  .landing-card--docs::before {
    background: linear-gradient(
      135deg,
      rgba(125, 211, 252, 0.28),
      rgba(29, 78, 216, 0.22),
      rgba(125, 211, 252, 0.28)
    );
  }

  .landing-card--docs::after {
    background: linear-gradient(
      135deg,
      rgba(125, 211, 252, 0.88),
      rgba(37, 99, 235, 0.32),
      rgba(125, 211, 252, 0.88)
    );
  }

  .landing-card--playground::before {
    background: linear-gradient(
      135deg,
      rgba(252, 211, 77, 0.28),
      rgba(194, 65, 12, 0.1),
      rgba(252, 211, 77, 0.28)
    );
  }

  .landing-card--playground::after {
    background: linear-gradient(
      135deg,
      rgba(253, 224, 71, 0.82),
      rgba(234, 88, 12, 0.3),
      rgba(253, 224, 71, 0.82)
    );
  }
</style>

<script src="../scripts/index.js"></script>
